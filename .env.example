# ====================================================================
# TAB Protocol - Environment Variables Configuration
# Copy this file to .env and fill in the values.
# NEVER commit your real .env file or private keys to source control!
# ====================================================================

# Monad Testnet Settings
# Official Monad Testnet RPC URL: https://testnet-rpc.monad.xyz
# Chain ID: 10143
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz

# Deployer Private Key (without 0x prefix or with 0x prefix)
# WARNING: Use a dedicated testnet development key funded only with testnet MON.
PRIVATE_KEY=your_private_key_here

# Optional: Monad Explorer API key for contract verification if supported
MONAD_EXPLORER_API_KEY=

# Local Development Settings
LOCALHOST_RPC_URL=http://127.0.0.1:8545

# Gas Reporting (optional: set to true to enable gas reporter in tests)
REPORT_GAS=false
