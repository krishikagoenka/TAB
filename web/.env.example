# TAB Frontend Environment Variables
# Copy this file to .env.local and fill in values

# Contract address (deployed by Person 1)
NEXT_PUBLIC_CONTRACT_ADDRESS=

# Monad Testnet RPC
NEXT_PUBLIC_CHAIN_RPC_URL=https://testnet-rpc.monad.xyz

# Chain ID for Monad Testnet
NEXT_PUBLIC_CHAIN_ID=10143

# Set to "true" to use mock adapter (no real blockchain)
NEXT_PUBLIC_USE_MOCK=true
